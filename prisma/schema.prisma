generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  AVAILABLE
  LOW_STOCK
  OUT_OF_STOCK
  DISCONTINUED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum PaymentMethod {
  CASH
  PROMPTPAY
  CREDIT_CARD
}

enum PaymentStatus {
  UNPAID
  PAID
  CANCELLED
  REFUNDED
}

enum MemberTier {
  GENERAL
  GOLD
  PLATINUM
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromoStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum MovementType {
  STOCK_IN
  SALE
  ADJUST_ADD
  ADJUST_MINUS
  WASTE
}

model Employee {
  id             String           @id @default(cuid()) @map("employee_id")
  firstName      String           @map("first_name")
  lastName       String           @map("last_name")
  email          String           @unique
  passwordHash   String           @map("password_hash")
  role           Role             @default(CASHIER)
  phone          String?
  hireDate       DateTime         @default(now()) @map("hire_date")
  status         EmployeeStatus   @default(ACTIVE)
  orders         Order[]
  wasteLogs      WasteLog[]
  stockMovements StockMovement[]
  @@map("employees")
}

model Category {
  id          String    @id @default(cuid()) @map("category_id")
  name        String    @map("category_name")
  description String?   @db.Text
  products    Product[]
  @@map("categories")
}

model Supplier {
  id          String    @id @default(cuid()) @map("supplier_id")
  name        String    @map("supplier_name")
  contactName String?   @map("contact_name")
  phone       String?
  email       String?   
  address     String?   @db.Text
  products    Product[]
  @@map("suppliers")
}

model Product {
  id           String        @id @default(cuid()) @map("product_id")
  categoryId   String        @map("category_id")
  supplierId   String?       @map("supplier_id")
  name         String        @map("product_name")
  unitType     String        @map("unit_type")
  costPrice    Decimal       @map("cost_price") @db.Decimal(10, 2)
  sellingPrice Decimal       @map("selling_price") @db.Decimal(10, 2)
  stockQty     Int           @default(0) @map("stock_qty")
  minStock     Int           @default(0) @map("min_stock")
  status       ProductStatus @default(AVAILABLE)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  orderDetails OrderDetail[]
  wasteLogs      WasteLog[]
  stockMovements StockMovement[]
  @@index([categoryId])
  @@index([supplierId])
  @@map("products")
}

model Customer {
  id           String       @id @default(cuid()) @map("customer_id")
  phone        String       @unique @map("phone_number")
  name         String       @map("customer_name")
  memberTier   MemberTier   @default(GENERAL) @map("member_tier")
  points       Int          @default(0)
  registerDate DateTime     @default(now()) @map("register_date")
  orders            Order[]
  pointTransactions PointTransaction[]
  @@map("customers")
}

model Promotion {
  id            String       @id @default(cuid()) @map("promo_id")
  name          String       @map("promo_name")
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(10, 2)
  startDate     DateTime     @map("start_date")
  endDate       DateTime     @map("end_date")
  status        PromoStatus  @default(ACTIVE)
  orders Order[]
  @@map("promotions")
}

model Order {
  id            String        @id @default(cuid()) @map("order_id")
  orderDate     DateTime      @default(now()) @map("order_date")
  employeeId    String        @map("employee_id")
  customerId    String?       @map("customer_id")
  promoId       String?       @map("promo_id")
  orderType     OrderType     @map("order_type")
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  netTotal      Decimal       @map("net_total") @db.Decimal(10, 2)
  paymentMethod PaymentMethod @map("payment_method")
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  employee      Employee      @relation(fields: [employeeId], references: [id])
  customer      Customer?     @relation(fields: [customerId], references: [id])
  promotion     Promotion?    @relation(fields: [promoId], references: [id])
  details       OrderDetail[]
  @@index([employeeId])
  @@index([customerId])
  @@index([orderDate])
  @@map("orders")
}

model OrderDetail {
  id         String  @id @default(cuid()) @map("detail_id")
  orderId    String  @map("order_id")
  productId  String  @map("product_id")
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(10, 2)
  note       String? @db.Text
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@index([orderId])
  @@index([productId])
  @@map("order_details")
}

model WasteLog {
  id           String   @id @default(cuid()) @map("waste_id")
  dateReported DateTime @default(now()) @map("date_reported")
  productId    String   @map("product_id")
  employeeId   String   @map("employee_id")
  quantity     Int
  reason       String   @db.Text
  costLost     Decimal  @map("cost_lost") @db.Decimal(10, 2)
  product      Product  @relation(fields: [productId], references: [id])
  employee     Employee @relation(fields: [employeeId], references: [id])
  @@index([productId])
  @@map("waste_logs")
}

model StockMovement {
  id           String       @id @default(cuid()) @map("movement_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  productId    String       @map("product_id")
  type         MovementType
  quantity     Int
  stockBefore  Int          @map("stock_before")
  stockAfter   Int          @map("stock_after")
  reason       String?      @db.Text
  employeeId   String       @map("employee_id")
  product      Product      @relation(fields: [productId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  @@index([productId])
  @@map("stock_movements")
}

model PointTransaction {
  id           String   @id @default(cuid()) @map("transaction_id")
  customerId   String   @map("customer_id")
  points       Int      
  description  String
  createdAt    DateTime @default(now()) @map("created_at")
  customer     Customer @relation(fields: [customerId], references: [id])
  @@index([customerId])
  @@map("point_transactions")
}